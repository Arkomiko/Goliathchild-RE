# Вход по сценарию Rebuild: пустой рабочий стол, «Обращение.txt», хаб ACT I и архив The Sadness.
# Текст дословно из «Рут Алисы» и «Документы». Вход в ACT II пока ведёт в акты прототипа (метка hub_bridge).

character page "[doc]" color=#000000

var hub_letter_read = false
var hub_zip_unlocked = false
var hub_interview_decoded = false
var hub_strange_found = false
var hub_journal_on = false
var hub_console_on = false
var hub_sadness_on = false
var hub_input = ""

# Пустой стол с одним файлом. Вызывается через call.
label hub_setup:
    scene "old2023/images/os/bg desktop.png"
    os desktop show
    os icon letter "Обращение.txt" image="os/icons/txt.png" side=left action=hub_letter
    return

# Глава из меню «История»: письмо уже прочитано, нора открыта.
label chapter_hub:
    ambient "old2023/audio/sfx/PC_Idle_loop_Intel.ogg" volume=0.3
    call hub_setup
    set hub_letter_read = true
    call hub_add_rabbit
    jump hub_open_rabbit

label hub_letter:
    os close
    doc "Обращение.txt"
    page "Временами мне казалось, что всё предприятие бесперспективно, а сам я схожу с ума, не имея возможности достучаться до тебя.{p=0.3}Я рад, что ты со мной, друг. Теперь так точно.{p=0.3}Прошу тебя — не боясь того, что увидишь далее, пройди вместе со мной весь этот путь, который проложен для тебя на этом жёстком диске. Ты найдёшь много занимательного и интересного.{p=0.3}И если у тебя появятся вопросы — в конце я обязательно дам ответы.{p=0.3}Используй Голема так, как посчитаешь нужным. Ты не один: временами мы будем помогать тебе, даже если ты не будешь замечать этого.{p=0.3}С уважением, ********."
    if not hub_letter_read:
        set hub_letter_read = true
        call hub_add_rabbit
        jump hub_open_rabbit
    jump game

# Папка-нора появляется после письма: начало ACT I и обучение работе с папками.
label hub_add_rabbit:
    checkpoint hub "Кроличья нора"
    os icon rabbit "Кроличья нора начинается здесь" image="os/icons/folder.png" side=left action=hub_open_rabbit
    os folder rabbit "Кроличья нора начинается здесь"
    os file rabbit stories "Истории" action=hub_open_stories
    os file rabbit modules "Обязательные модули для работы с VMCFS (ВАЖНО)" action=hub_open_modules
    os file rabbit interview "Наше первое милое интервью" action=hub_interview
    os folder stories "Истории"
    os file stories up ".." action=hub_open_rabbit
    os file stories collage "Стремительный рост апокалиптических настроений.jpg" action=hub_collage
    os file stories forum "Итак — война! (presentdays.org, форум).html" action=hub_forum
    os file stories wall "F*** ******.jpg" action=hub_wall
    os file stories novel "Отрывок из романа Т.П. Харольда.doc" action=hub_novel
    os folder modules "Обязательные модули для работы с VMCFS (ВАЖНО)"
    os file modules up ".." action=hub_open_rabbit
    os file modules manual "Руководство по эксплуатации.txt" action=hub_manual
    os file modules chat "Но кто-то ничего не понял.doc" action=hub_chat
    os file modules clip "Вырезка из газеты «Южносибирский буревестник» от 07.06.2000" action=hub_clip
    os file modules zip "My_modules.zip" action=hub_zip
    return

label hub_open_rabbit:
    os open rabbit
    jump game

label hub_open_stories:
    os open stories
    jump game

label hub_open_modules:
    os open modules
    jump game

# ---------------------------------------------------------------- обязательные модули

label hub_manual:
    os close
    doc "Руководство по эксплуатации.txt"
    page "Вы думали, что здесь будет какой-то нудный текст? Ха-ха! Но нет, я знаю, что вы скорее сдохнете, чем будете читать обо всех подробностях, которые — вы уверены! — вам не понадобятся. Разве я не прав?{p=0.3}Ну а говоря откровенно, я вообще без понятия, как здесь всё работает. Это вы мне должны объяснять, вы же тут умники компьютерные :’> Как мне Кхилл объяснил, так и настроил. И — магия! — всё заработало!{p=0.3}Если вы смогли запустить виртуальную эмуляцию, значит, вы уже сделали половину дела. Осталось малое: найдите один из модулей — вы же не хотите сказать, что у вас нет модуля? — и установите его. После этого можете задать вопросы ИИ. Наверняка он лучше знает, как он работает, чем я."
    page "Но если же что-то не получится — пишите и спрашивайте. Только пожалуйста — без фанатизма! У меня есть личная жизнь."
    jump hub_open_modules

label hub_chat:
    os close
    doc "Но кто-то ничего не понял.doc"
    page "Ну кто ж знал…"
    ki "Kira: <Здравия, Гирби>"
    ge "Geirby: <О! Тебе что-то нужно, да, родной?>"
    ki "Kira: <Хех. Ну да, ты же сам написал в файлике — писать>"
    ge "Geirby: <В каком файлике?>"
    ki "Kira: <…>{p=0.3}<Ты издеваешься надо мной, да?>{p=0.3}<Ты отправил виртуалку, в ней был файлик-readme. Думай, дедушка, думай. Вспоминай, дедушка>"
    ge "Geirby: <Да уж, старость не радость :555>{p=0.3}<Ну ок. У тебя уже какие-то вопросы появились? >"
    ki "Kira: <Ну, можно и так сказать. Где ты мне предлагаешь взять модули, о которых ты пишешь?>"
    ge "Geirby: <В смысле где? Я тебе его отдельно отправлял. Самому первому, по сути. Даже раньше Шопена>"
    ki "Kira: <Где? У меня тупо ничего нет>"
    ge "Geirby: <Выше полистай. Сообщений пять до диалога :)>"
    ki "Kira: <У меня ничего нет. Не хочешь же ты сказать, что модуль — это анекдот про холодец?>"
    ge "Geirby: <Што>{p=0.3}<Шкет, ты меня точно разыгрываешь! Есть всё, тебе сфотографировать?>"
    ki "Kira: <Не надо. Просто перекинь ещё раз. Видимо, какой-то баг>"
    ge "Geirby: <Был бы я лично при тебе — начал бы кряхтеть под ухо…>"
    ki "Kira: <Можешь покряхтеть в телефон. Номер дать?>"
    ge "Geirby: <Не надо. Обойдусь :ееее>"
    page "Файл My_modules.zip (26.69 mb)  отправлен Kira"
    ge "Geirby: <Ну всё, теперь должно появиться>"
    ki "Kira: <Есть, да. Благодарю>{p=0.3}<…Погодь, а пароль какой?>{p=0.3}<Зачем вообще пароль нужен???>"
    ge "Geirby: <Да прост. Чтоб ты спросил ^_6>{p=0.3}<Пароль — genium malignum>"
    ki "Kira: <Какой кошмар. Это опять какая-то латинская отсылка?>"
    ge "Geirby: <Угу) Но я тебе про неё ничего не скажу. Сам разбирайся :)))>"
    ki "Kira: <Больно надо. Считай, что я обиделся>"
    ge "Geirby: <Как говорил народ—богоносец, на обиженных воду носят. Если обидел — не обижайся :)>"
    ki "Kira: <Хех>{p=0.3}Kira: <Я надеюсь, оно того стоит>{p=0.3}Kira: <Шилл уже мозг проел этими модулями>{p=0.3}Kira: <Взламывать военные сервера собрался, не иначе>"
    jump hub_open_modules

label hub_clip:
    os close
    doc "Южносибирский буревестник, 07.06.2000"
    page "Аспирант **ГУ сделал крупное астрономическое открытие{p=0.3}С древнейших времен звездное небо приковывает любопытные взгляды и занимает самые пытливые умы: оно скрывает тайны, которые — как показывает история — заставляли людей полностью пересмотреть их представление о Мире.{p=0.3}Еще в советское время в нашем городе были организованы планетарий и обсерватория, до сих пор вносящие свою лепту в развитие отечественной науки. За последние полвека *****кими астрономами – как любителями, так и профессионалами – было открыто свыше 60-ти космических объектов.{p=0.3}На фоне трудностей, переживаемых региональной наукой, особенно радуют достижения молодых исследователей: студентов *****ких вузов, магистрантов и аспирантов."
    page "При поддержке научного руководителя, О.В. Глушинской, кандидата физико-математических наук и известного специалиста по эволюции звёздных систем, аспирант второго курса **ГУ {color=#2a3fa8}SchHill{/color} открыл примечательный астрономический объект, который может оказаться крайне интересным для его коллег.{p=0.3}Открытие {color=#2a3fa8}SchHill{/color} уникально по двум причинам: во-первых, многое указывает, что найденный им объект — это газовый гигант в процессе своего формирования: если всё будет подтверждено, на основе этого объекта учёные смогут проверить свои гипотезы о формировании объектов данного класса; во-вторых, {color=#2a3fa8}SchHill{/color} использовал современные компьютерные технологии, что пока что в новинку для отечественной науки”, дала нам комментарий Ольга Владимировна."
    page "{color=#2a3fa8}SchHill{/color} вместе со своим научным руководителем готовят несколько публикаций, в которых будет описаны не только результаты их наблюдений, но и методы, которыми они [[запись обрывается...]{p=0.3}[[...]Несколько слов оставил нам и сам молодой учёный:{p=0.3}{color=#b02020}Как же я ненавижу вот этот вот журналистский стиль. Любители раздувать из мухи слона. Черви, не понимающие, какая великая фигура ходила по вам и ходила бы дальше, если…{/color}{p=0.3}{color=#b02020}Чёртов Бёрнс и чёртова Вселенная. Всё, что мне остаётся — глядеть на Вечность, надеясь, что когда-нибудь всё закончится. Закончится мир, а вместе с ним — мои страдания. Всё — как всегда. Печаль будет длиться вечно.{/color}"
    page "{color=#b02020}Я знаю, SchHill, ты будешь зол на меня за то, что я замарал твоё — такое важное! — мнение. Но я знаю лучше, что тебе нужно. Никому не стоит знать, какие глупости ты говорил тогда, в первые, самые наивные месяцы. Если бы ты меня увидел — ты бы наверняка согласился со мной.{/color}{p=0.3}{color=#b02020}Ни капли слёз. Ни капли сожалений.{/color}{p=0.3}[[...]Да, я уже придумал имя для планеты. Если Международный Астрономический союз примет его, газовый гигант будет иметь имя Роберта Бёрнса, великого шотландского поэта”.{p=0.3}{color=#b02020}HDK-20 encode{/color}"
    jump hub_open_modules

# Пароль архива — из чата Kira и Geirby.
label hub_zip:
    if hub_zip_unlocked:
        jump hub_open_zip
    input hub_input "Введите пароль"
    if normalize(hub_input) == "genium malignum":
        set hub_zip_unlocked = true
        os folder zip "My_modules.zip"
        os file zip up ".." action=hub_open_modules
        os file zip music "Music_Powda.vmc" action=hub_mod_music
        os file zip listing "Listning.vmc" action=hub_mod_journal
        os file zip xmas "XmasGift.vmc" action=hub_mod_console
        jump hub_open_zip
    elif hub_input != "":
        os error "My_modules.zip" "Неверный пароль!"
    jump game

label hub_open_zip:
    os open zip
    jump game

# Модули включают программы на рабочем столе.
label hub_mod_music:
    os icon player "Music_Powda" image="os/icons/player.png" side=left action=hub_open_player
    os folder player "Music_Powda"
    os file player t1 "Pix_SeiAmbi" action=hub_track1
    os file player t2 "PixWater_Rain" action=hub_track2
    os file player t3 "Ninshiki" action=hub_track3
    os file player t4 "Pixlirkis" action=hub_track4
    os file player stop "■ Стоп" action=hub_track_stop
    notify "Модуль установлен: Music_Powda.vmc"
    jump game

label hub_open_player:
    os open player
    jump game

label hub_track1:
    music "old2023/audio/music/Pix_SeiAmbi.ogg" volume=0.3
    jump game

label hub_track2:
    music "old2023/audio/music/PixWater_Rain.ogg" volume=0.3
    jump game

label hub_track3:
    music "old2023/audio/music/Ninshiki.ogg" volume=0.3
    jump game

label hub_track4:
    music "old2023/audio/music/Pixlirkis.ogg" volume=0.3
    jump game

label hub_track_stop:
    stop music fadeout=1
    jump game

label hub_mod_journal:
    set hub_journal_on = true
    os icon journal "Журнал" image="os/icons/journal.png" side=left action=hub_journal
    notify "Модуль установлен: Listning.vmc"
    jump game

label hub_journal:
    os close
    doc "Журнал"
    page "Пароль от My_modules.zip — в файле «Но кто-то ничего не понял.doc»."
    if hub_strange_found:
        page "Странный файл. Командная строка?"
    jump game

label hub_mod_console:
    set hub_console_on = true
    os icon console "XmasGift" image="os/icons/console.png" side=left action=hub_console
    glitch 0.3 0.2
    notify "Модуль установлен: XmasGift.vmc"
    jump game

# Консоль ключевых слов: пока работает только «странный файл».
label hub_console:
    input hub_input "XmasGift.vmc >"
    if hub_input == "":
        jump game
    if hub_interview_decoded and not hub_sadness_on and normalize(hub_input) == "странный файл":
        jump hub_sadness_load
    os error "XmasGift.vmc" "ДОСТУП ОГРАНИЧЕН"
    jump game

# ---------------------------------------------------------------- интервью

label hub_interview:
    if not hub_interview_decoded:
        os close
        doc "Наше первое милое интервью"
        page "ÍŕřĺĺĎĺđâîĺ ěčëîĺ číňĺđâü˙ ╬ó… ╥ŕę ěű ń ňîáîé çíŕęîěű? ╩ŕę áóäňî íčęîăäŕ íč÷ĺăî íĺ ńëűřŕëŕ î ňĺáĺ, čçâčíč… ╧î ęđŕéíĺé ěĺđĺ, ˙ áű ňĺá˙ çŕďîěíčëŕ, íŕâĺđíîĺ."
        input hub_input "Кодировка файла"
        if not contains(normalize(hub_input), "hdk 20") and not contains(normalize(hub_input), "hdk20"):
            if hub_input != "":
                os error "Кодировка" "Неизвестная кодировка."
            jump hub_open_rabbit
        set hub_interview_decoded = true
        glitch 0.3 0.2
    os close
    doc "Наше первое милое интервью"
    page "Оу… Так мы с тобой знакомы? Как будто никогда ничего не слышала о тебе, извини… По крайней мере, я бы тебя запомнила, наверное. Если бы мы виделись живьём.{p=0.3}А вот ты как будто знаешь обо мне слишко много, хе-хе-хе. Не будь ты таким симпатичным, я бы наверняка занервничала.{p=0.3}О чём ты хочешь поговорить со мной? О прошлом? О временах моей, так сказать, бурной молодости? Мне было тогда 18 лет, да…{p=0.3}Ты правда хочешь узнать больше о нашем знакомстве с ребятами? Никогда бы не подумала, что это может быть интересно…"
    page "Забавно: если честно, я почти каждый день вспоминаю то время, но у меня не было возможностей поговорить о нём… Если ты и правда юзер с presentdays, то мне будет проще. Жаль, я никогда не замечала тебя… Хах, и как же ты познакомился с Шопеном? Я бы хотела потом узнать подробности…{p=0.3}Flou_ren — это что-то про цветы, да? Красивый никнейм. Даже галантный, если ты был милым мальчиком. Тебе тогда было лет 15, да? Я надеюсь, что ты и правда был милым и хорошим. Буду представлять, что тогда, по другую сторону, вместо моих друзей сидел ты-маленький. Ах-хах!{p=0.3}(Недолго смеётся, извиняясь за несдержанность. Периодически проверяет свой телефон на столе)."
    page "…А? Нет, я не знала, как ребята выглядят, конечно. Мы все пользовались псевдонимами и фейковыми аватарками. Переписывались, но не выходили на контакт иными способами. Встретились сильно позже, лишь через…"
    page "Так что тебе рассказать, Флуран? Я могу вспомнить так много всего! То время — перепутье — изменило меня, как я и не могла представить. Спасибо… одному старому другу, я смогла познакомиться со странными, но яркими, великолепными ребятами. Оказавшись в компании старших, я могла чувствовать себя увереннее и… отчаянее, я бы сказала. Ребята изучали интернет, и мне было приятно присоединиться к ним. Ты, может быть, помнишь те масштабные обсуждения самых разных интернет-баек по типу смертельных файлов или посланий из будущего, появляющихся будто бы на “мёртвых” серверах, написанных то ли инопланетянами, то ли мёртвыми людьми с того света, то ли ещё кем-то, о ком мы ничего не знаем. Один из нас особенно любил участвовать в таких обсуждениях."
    page "Иногда он даже подкидывал свои домыслы через фейк-аккаунты, чтобы подогреть интерес!{p=0.3}Да, тогда всё оно казалось забавным, наверное. Особенно если тебе было 15 лет, хах.{p=0.3}На самом деле многие из тех историй были приукрашиваниями, но не обманом. Если бы ребята рассказывали прямо, чем мы занимаемся, у нас наверняка бы возникли… некоторые проблемы. Как минимум — в понимании. Как максимум…{p=0.3}Если рассказывать про реальную работу админсостава presentdays, то история выйдет куда сложнее, но и интереснее."
    page "Тогда — может, помнишь… — в интернете жилось как-то иначе. Больше свободы, больше возможностей. А когда начались странности из-за Заповедника, все и правда были уверены, что мы на пороге какого-то открытия. Все были в таком предвкушении…! Очень жаль, что за какие-то пять лет весь энтузиазм выдохся.{p=0.3}А мне… мне было достаточно, что я нашла новую компанию. Старый друг познакомил меня с ребятами, и я смогла найти в них поддержку. Это… ну, короче говоря, в то время мне правда нужна была поддержка.{p=0.3}Но вообще-то… У нас были свои открытия, хе-хе-хе. И мы о них никому не рассказывали, конечно. Хочешь, расскажу?{p=0.3}…АХАХАХАХ! Всё началось с того, что  я однажды открыла один {color=#b02020}странный файл{/color}…"
    menu:
        "Выделить: «странный файл»":
            if not hub_strange_found:
                set hub_strange_found = true
                notify "Журнал: новая запись"
        "Закрыть файл":
            jump hub_open_rabbit
    jump hub_open_rabbit

# ---------------------------------------------------------------- The Sadness

label hub_sadness_load:
    set hub_sadness_on = true
    glitch 0.3 0.4
    notify "Загрузка файла завершена: The Sadness"
    os icon sadness "The Sadness" image="os/icons/image.png" side=left action=hub_open_sadness
    os folder sadness "The Sadness"
    os file sadness prol "Prolegomena.doc" action=hub_prolegomena
    jump game

label hub_open_sadness:
    os open sadness
    jump game

# Файлы открываются по порядку: следующий появляется после прочтения предыдущего.
label hub_prolegomena:
    os close
    doc "Prolegomena.doc"
    page "presentdays.org/prol.html{p=0.3}FAQ, обращение и всякое прочее:"
    page "1. О сайте:{p=0.3}Сайт был создан в феврале 2000 года главными админами SchHill и Chopin как место, где можно спокойно обсуждать мистические события, произошедшие после т.н. Проложения. Со временем тематика и интересы сообщества расширились, и сейчас вы можете найти компанию практически для любого общения, связанного с Интернетом и его культурой."
    page "2. О разделах:{p=0.3}Presentdays.org имеет несколько основных тем для обсуждения:{p=0.3}1. Теории заговора: обо всём, о чём вы боялись подумать, можно рассказать здесь. Только думайте хоть иногда, что ИМЕННО вы рассказываете :){p=0.3}2. Аниме: было бы странно, не будь у нас аниме. Помогаем с поиском субтитров и переводами, иногда собираем людей с микрофонами, чтобы говорить в него слова.{p=0.3}3. Киберпанк: кино, игры и фильмы. Показывайте, какие вы эрудиты.{p=0.3}4.  Творческий уголок: если вы хотите показать свой рассказ, песню или картинку — вам сюда. Кусать не будут. Разве что чуть-чуть.{p=0.3}5. Технический уголок: бойцы компьютерного фронта найдут здесь убежище."
    page "6. Заповедник: идеологическое ядро сообщества. Наблюдаем за мёртвыми серверами, нетсталкерим и ищем вкусности. Добираемся до Дома Интернета. Пугаем и пугаемся."
    page "3.  Админсостав:{p=0.3}Основной состав администрации:{p=0.3}1. SchHill (первая голова, главный модератор Заповедника){p=0.3}2. Chopin (вторая голова, основной модератор творческого раздела){p=0.3}3. Geirby_geirby (дипломат и ритор сообщества, основной модератор раздела теорий заговора){p=0.3}4. Kira (главный мозг, основной модератор технического раздела){p=0.3}5. Celia (наш талисман, основная модераторша раздела про аниме и киберпанк){p=0.3}(Мы — не идолы и не боги. Если вы с нами не согласны — пишите. Но без оскорблений, друзья. Иначе — пеняйте на себя).{p=0.3}Состав модераторов:{p=0.3}1. KHAN{p=0.3}2. Dead_Philosophy{p=0.3}3. Bib_22"
    page "4. El_Fabio{p=0.3}Особые благодарности:{p=0.3}Comrade_Chrome{p=0.3}Animu_Konata{p=0.3}D1kuscha{p=0.3}Eretik{p=0.3}PHETISCH{p=0.3}Musical_Pudding{p=0.3}Ruslan_Fox{p=0.3}orbllitS{p=0.3}Almanto{p=0.3}morsha_vn"
    page "4. FAQ:{p=0.3}За последний год работы активной группы у многих пользователей (особенно новичков) создалось превратное впечатление о нас. Поэтому мы оставили небольшой FAQ, в котором отвечаем на самые распространённые вопросы:"
    page "Q. Чем вы занимаетесь?{p=0.3}A. Модерируем сайт, изучаем информацию, отправляемую пользователями, а также собираем её сами, обсуждаем, пишем обзоры и статьи. К сожалению, многие шутники отправляют нам непроверенные, а зачастую и вовсе выдуманные истории. Просим воздержаться от преднамеренных вбросов."
    page "Q. Вы что-то вроде элитарного клуба сайта?{p=0.3}A. Разумеется, нет. Всех нас можно встретить на форуме и других разделах сайта. Если у вас появятся вопросы, вам будет, что рассказать или станет скучно, вы всегда можете написать. Только не удивляйтесь, что за спам и глупость мы можем вам очень недовольно ответить :)"
    page "Q. Готовы ли вы к расширению группы?{p=0.3}A. Расширение группы не улучшит её работу. Прошлые попытки расширить состав группы ни к чему серьёзному не привели. Поэтому — нет, сейчас мы не готовы."
    page "Q. Какие полномочия у членов вашей группы?{p=0.3}А. Каждый отвечает за каждого."
    page "Q. А если серьёзно?{p=0.3}А. А если серьёзно — мы стараемся сохранять доверительные отношения. Поэтому разделение обязанностей нигде и никем не закреплено. Разумеется, у каждого есть своя сфера интересов, о которой вполне можно составить представление, если проследить за нашей активностью на сайте. Какие-то личные подробности мы бы хотели оставить при себе. Надеемся на понимание."
    page "Q. Есть ли у вас какие-то серьёзные достижения?{p=0.3}A. Конечно! Из наиболее почётного — “золотой список” ресурсов с уникальными книгами, фильмами и ПО, самоотверженно составленный Geirby и Chopin. Как показал беглый осмотр, многие из этих файлов больше нигде и не найти."
    page "Q. Можете рассказать подробнее про историю Honest_Poverty?{p=0.3}AAAAAAAAAAAA"
    page "Q. Это правда, что вы занимаетесь сбором т.н. “смертельных” Интернет-файлов?{p=0.3}A.  Да, разумеется. Это лишь часть того, чем мы занимаемся. Хоть многие из этих файлов на деле никогда не существовали, некоторые, похоже, имеют какую-либо связь с реальностью. Все интересные находки мы публикуем и обсуждаем в соответствующих топиках на форуме."
    page "{p=1}\n\n\nQ. А что насчёт тех файлов, что вы оставляете при себе?"
    os file sadness chopin "Переписка Chopin и SchHill" action=hub_chopin
    jump hub_open_sadness

label hub_chopin:
    os close
    doc "Переписка Chopin и SchHill"
    page "…Помню, я разложил перед монитором мои любимые шоколадки. Я не хотел потом отвлекаться в процессе. Остаюсь в потоке."
    ch "Chopin: <Как ты, Шилл?>"
    page "Никогда не жду, что он будет отвечать сразу же, по возможности. Уж таков он. Занятой.{p=0.3}Но сегодня не так. Минут через двадцать — я только открыл presentdays, предвкушая чудесный вечер в компании настоящих мужчин — он всё-таки ответил, в своей обычной манере:"
    sc "SchHill: <Да вроде как всегда — местами живой, местами всё — как надо>{p=0.3}SchHill: <Но ты опять не согласишься со мной, наверное. Будто я уже должен сидеть и слюни пустить, хех>"
    page "Поразительный человек. Иногда, правда, он поражает неприятно."
    ch "Chopin: <Просто был уверен, что ты будешь переживать и волноваться>"
    sc "SchHill: <Глупости. Трудности нужны, чтобы через них переступать>"
    ch "Chopin: <…И игнорировать их?>"
    sc "SchHill: <Хех>{p=0.3}<В любом случае, чувствую я себя нормально>{p=0.3}<Жаловаться не на что. Давай не будем об этом>"
    ch "Chopin: <Ладно. Постараюсь тебе поверить>{p=0.3}<Как твои успехи?>"
    sc "SchHill: <Ты про Бёрнса?>"
    ch "Chopin: <Если ты хочешь рассказать про него — да>"
    sc "SchHill: <Хех :)>{p=0.3}SchHill: <Да всё так же. Разве что О.В. просмотрела, что я там понаписал>{p=0.3}SchHill: <Сказала, что можно опубликовать в студенческом журнале, но РАН могут и протащить>"
    ch "Chopin: <Почему? Разве ты не приводил результаты своих наблюдений?>"
    sc "SchHill: <Приводил, конечно. И все расчёты привёл. Но она всё равно уверена, что я слишком самоуверен>{p=0.3}<Она с трудом скрывает, что я слишком много думаю о непонятном гиганте, который ещё и увидеть сейчас невозможно>"
    ch "Chopin: <Если ты нашёл космический объект по косвенным признакам, разве не логично с её стороны занять умеренную позицию?>{p=0.3}<Сам посуди: для человека со стороны Бёрнс — ничем не примечательная планета, которая ещё не факт, что существует>"
    sc "SchHill: <Существует>"
    ch "Chopin: <Опять ты самоуверен =)>{p=0.3}Chopin: <Ок, существует. Но не факт, что так, как ты себе это представляешь>{p=0.3}Chopin: <В итоге тебе сейчас терять нечего. А она опростоволосится>"
    sc "SchHill: <Так говоришь, будто я должен, как слепой котёнок, доверять только своему нюху>{p=0.3}<Я смог определить, из каких веществ состоит Бёрнс. Я знаю его траекторию. А ещё я понимаю, что Бёрнс как-то связан с Проложением. Мне не нужно, как тупоголовой обезьяне, видеть его вживую, чтобы знать, что он реален>{p=0.3}<Это… излишне>"
    ch "Chopin: <Ага, учитывая, что ты его вполне видел, да?>"
    sc "SchHill: <Хе-хе-хе-хе…>{p=0.3}<Это уже художественное дополнение>"
    ch "Chopin: <К слову, не против отправить номер журнала?>"
    sc "SchHill: <Какой?>"
    ch "Chopin: <Красивый, двадцатидвухлетний>{p=0.3}<Сам понимаешь, какой, не придуривайся>"
    sc "SchHill: <Ого. Собираешь мои достижения?)>"
    ch "Chopin: <Ну даже если. В чём проблема?>"
    sc "SchHill: <Да в принципе… Хе-хе>{p=0.3}<Тогда у меня будет подарочек. Приложение>{p=0.3}<Сегодня приезжали журналисты. Брали, считай, интервью>{p=0.3}<Хотели написать заметку про меня в газете>{p=0.3}<Что вот-де многообещающий учёный, великий первооткрыватель>{p=0.3}<В течение недели она выйдет, вместе — журнал и газетку — и отправлю>{p=0.3}<Только мне, правда, совсем не понравилось, что я им сказал>{p=0.3}<Вышло слишком… сентиментально. Был ещё под эмоциями и всё такое>{p=0.3}<С радостью бы всё переписал и переделал, но — увы>"
    ch "Chopin: <Переписать за тебя?>"
    sc "SchHill: <Хех. Ну если сможешь — желательно во всём тираже — то будет прекрасно>"
    ch "Chopin: <Удивительно, что ты вообще согласился на интервью>{p=0.3}Chopin: <Ты, кажется, не любил интервью>{p=0.3}Chopin: <Как и журналистов>"
    sc "SchHill: <Я свои слова назад не забираю. Но зачем возмущаться из-за таких пустяков?>"
    ch "Chopin: <А это был пустяк?>"
    sc "SchHill: <Если бы мне не сказали, я бы и не знал, что мною интересуются. Значит, и вправду мелочь>{p=0.3}<С другой стороны, если эта заметочка хоть немного мне поможет, то с чего бы мне от неё отказываться?>"
    ch "Chopin: <Как всегда, пытаешься в здравомыслие. Если не знать тебя — подумаешь, что ты хладнокровен>"
    sc "SchHill: <Я и есть хладнокровие. Даже если немного взволнован>"
    page "Сложно не улыбнуться. Я думал, что получилось — Шилл отвлёкся и чувствует себя как обычно. Что ж…"
    sc "SchHill: <Ладно. Возвращаясь к Семерым>"
    page "…По спине пробежал холодок."
    ch "Chopin: <И что ты хочешь сказать?>{p=0.3}<Думал, ты хочешь забыть эту историю>"
    sc "SchHill: <Забыть?>{p=0.3}<АХАХАХАХАХА>{p=0.3}<Совсем, что ли?>{p=0.3}<Подобные вещи не забываются>{p=0.3}<Тут, если угодно, уже личный должок>{p=0.3}<Какая-то мразь залила uriel.txt. Кто-то это точно сделал>{p=0.3}<Или что-то. Неважно, со всех спросим!>"
    ch "Chopin: <Что ты задумал?>"
    sc "SchHill: <Продолжая продолжать!>{p=0.3}<Проложение, Заповедник, Бёрнс, всякая жуть, гуляющая по интернету. Всё это связано и переплетено>{p=0.3}<Осталось протянуть руку и узнать, каким образом>{p=0.3}<Тем более — у меня есть план действий>"
    ch "Chopin: <Спешишь стать Восьмым, Шилл?>"
    sc "SchHill: <Не боись. Начну с создания — хех! — протоколов безопасности. Никто не станет Восьмым>{p=0.3}<Я собираюсь списаться с Dead_Philosophy. Он мне сказал, что нашёл что-то>{p=0.3}<Предположительный Объект №2>{p=0.3}<Он у нас мальчик умный, даром, что идиот. Уже понял, что лучше всю эту жуть не распространять>{p=0.3}<По крайней мере пока не подтвердится её безопасность>"
    ch "Chopin: <”Админсостав presentdays.org отрицает, что сообщества как-либо связано с распространением файла uriel.txt. Пожалуйста, не распространяйте дезинформацию о существовании этого файла. Если найдёте ссылку на скачивание — ни в коем случае не переходите по ней, скорее всего, вы обнаружите вирус. Uriel.txt — всего лишь плод фантазии некоего писателя нашего сообщества, не воспринимайте эту историю слишком буквально”>"
    sc "SchHill: <Хе-хе-хе…>{p=0.3}<Это было унизительно, да>{p=0.3}<Самая неприятная сделка с совестью за всю мою жизнь, наверное>{p=0.3}<С другой стороны, меня ещё никогда легавые так не давили>{p=0.3}<Поделом>"
    ch "Chopin: <Каково это — искать файлы, которые не существует?>"
    sc "SchHill: <Сногсшибательно>{p=0.3}<Киберэзотерично!>"
    os file sadness object "Файл о Проложении" action=hub_object
    jump hub_open_sadness

label hub_object:
    os close
    doc "Файл о Проложении"
    page "И здесь тоже 7-го января нового 2000-го года произошло знаменательное событие.{p=0.3}Я часто посещал некоторые сайты, интересные мне с… профессиональной точки зрения. Сводки новостей из Англии, европейские экономические и политические сайты. Таким нехитрым образом я старался сохранять руку на пульсе с эпохой, в которой очутился. На сайтах часто напоминали про т.н. проблему 2000-го года, безостановочно уверяя нас, что сами они уже приняли все меры предосторожности и призывают всех окружающих последовать их примеру."
    page "1 января они полегли первыми. Если честно — стоило ожидать: в этом происшествии так много злой иронии, что оно неизбежно должно было случиться. Как бы то ни было, это не странно: технические неполадки случаются, поэтому я стал ждать, когда ошибки исправят. И их быстро исправили.{p=0.3}Но не совсем. Чинили один сайт и ломался новый. Я не мог наблюдать за всем Интернетом, но мои друзья следили повнимательнее. Очень скоро затрубили о странности и иностранцы, испанцы и французы: их Интернет-сервера ложились не менее бодренько."
    page "Скандал был неимоверный — кибербезопасники оглушительно провалились, люди оказались разочарованы. Очередная причина поднять шум из ничего; в США и у нас активизировались фрики, уверенные, что это — предзнаменование Апокалипсиса и конца всех времён. Хотя большинство — особенно среди специалистов — лишь вздыхало, что они отделались малой кро…{p=0.3}К вечеру второго января в Западной Европе неполадки были в массе своей устранены. И третьего числа они начались на Востоке США."
    page "Необъяснимо, но факт: этот странный эффект, названный нами Проложением, перемещался с постоянной скоростью с востока на запад вдоль всей параллели. Самое забавное — скорость было хитро подстроена, чтобы момент починки старых серверов и поломки новых были более или менее синхронизированы, как будто что-то контролировало работу сотен и тысяч специалистов, борющихся с аномалией.{p=0.3}И хоть никаких (удовлетворительных) доказательств массового взлома или DDOS приведено не было, почти никто не сомневается в некоем сознательном вмешательстве. Специалисты, правда, сразу же начали называть такие предположения “кибермистицизмом”; даже Арз сказал, что не видит во всём этом человеческого влияния."
    page "<Больше похоже на стихийное бедствие. Если, конечно, природа может влиять на информацию, на виртуальность>.{p=0.3}Самым грустным итогом Проложения стало отключение большого количества старых, legacy-сайтов. Большое наследие Интернета безвозвратно погибло.{p=0.3}Но, может, получится их возродить…? Мне стало интересно, и я написал своему хорошему знакомому, задав лишь один вопрос…"
    menu:
        "Flou_ren":
            page "И если не человек повлиял, то не мог ли кто-то другой?"
        "Закрыть файл":
            set hub_input = ""
    os file sadness six "Работа над объектом №6, 21.04.2002" action=hub_six
    jump hub_open_sadness

label hub_six:
    os close
    doc "Работа над объектом №6, 21.04.2002"
    sc "SchHill: <Микро? Чё ты там, на связи?>"
    page "Сообщение висело часа три, пока я спала."
    al "Celia: <Не называй меня Микро. Ты меня бесишь>."
    sc "SchHill:<АХАХАХАХ. Ладно, ладно. Ты зайдёшь в чат уже?>"
    al "Celia:<Зачем?>"
    sc "SchHill: <Ну как всегда. Нужна будет помощь>."
    al "Celia: <Опять сидеть и повторять за всеми?>."
    sc "SchHill: <Я хочу быть уверен, что эксперимент воспроизводится устойчиво. Уж извини, привычка-с>."
    al "Celia: <Пятикратное повторение принципиально лучше четырёхкратного?>."
    sc "SchHill: <Когда дело касается важных вещей — безусловно лучше>."
    page "Я вздохнула. Всё равно ему ничего не докажешь. Как и всегда, Хилл слишком упрям и самодоволен."
    sc "SchHill: <Тем более, родная, у нас на улице праздник. Есть успехи. Знаменательный день!>"
    al "Celia: <Ты нашёл нормальную работу?>"
    sc "SchHill: <АХАХАХ. Нет, круче. Кому эта работа нужна, когда решается судьба Вселенной?>"
    al "Celia: <Обсохни>."
    sc "SchHill: <За это мы тебя и любим. Здоровый цинизм>.{p=0.3}SchHill: <Лан, все в сборе, все ждём. Давай, молодуха, заходи на вечерочек, одна ты осталась>."
    page "Если честно, шутки Гирби мне нравятся больше. Но я не хочу расстраивать Хилла и помалкиваю. Как, впрочем, и всегда.{p=0.3}…В общем чате шутеха: тот самый Гирби совсем распоясался в воскресный вечер:"
    ge "Geirby: <…Студент встаёт, начинает зачитывать этот чёртов Щит Ахиллеса. Выходит всё складно, красиво, ну я и начал подозревать что-то. Спрашиваю у молодёжи, что он только что прочитал. Тут же, разумеется, возражения, что он-де “наизусть запомнил”. Ну гаврик)))"
    page "Ну я переспрашиваю, что он “наизусть запомнил”. Дальше — феерия :) Ахиллес в процессе успел превратиться в Хилерса (healer, что ли?), Патрокл — в Патрона (молодёжь даже не представляла, насколько оказалась права!), а “Илиада” — в историю мести молодого земледельца за своего друга, убитого псом Гектором (это уже от меня добавление)>."
    ki "Kira: <Я сейчас заплачу>."
    ch "Chopin: <Какой кошмар. И что ты со студентом сделал?>."
    ge "Geirby: <Ох… Ну, хотелось, конечно, аки Немезида, простерть совиные крыла над беднягой. Но он был настолько искренен в своей глупости, что я не выдержал и начал подыгрывать ему. В итоге сам не заметил, как поставил пятёрку>."
    ch "Chopin: <Преподаватель вряд ли будет доволен>."
    ge "Geirby: <Ну так а откуда он узнает? Если молодёжь не исправится к экзамену — скажу, что он сошёл с ума где-то в промежутке. Шалость удалась>."
    ki "Kira: <Твои таланты клоуна требуют лучшего применения>."
    ge "Geirby: <В корне не согласен. Я расцветаю, только если я единственный клоун в цирке))>"
    page "…Каждый раз, когда они так собираются, я представляю их где-нибудь на кухне, слушающих на фоне водки шансон.  Удивительная иллюзия для общества, разделённого сотнями километров."
    sc "SchHill: <Извините, друзья, что прерываю. Но у нас с вами неотложное дело исключительной важности>."
    ch "Chopin: <Опять что-то ломаем?>"
    sc "SchHill: <Нет. Куда ещё ломать? Пол интернета сломалось. Пол интернета вопит. Нет, всё самое интересное уже мною сделано. От вас мне нужно только участие>"
    ki "Kira: <Дело как-то связано с лабораторными мультиками?>"
    page "…На прошлой неделе один из юзеров presentdays — пафосный и неприятный Dead_Philosophy — показал форуму несколько выпусков мультфильмов непонятного содержания, которые он нашёл в Заповеднике. Шопен сравнил их с тестом Роршаха в клиниках: психодел, резкие контрастные переходы, разноцветные фоны, сменяющиеся хаотично. Некоторые говорят, что от такого у них начинает болеть голова; но, по существу, ничего опасного в мультах нет. Хилл как-то заметил, что они ему напоминают калибровку телевизора; может, их использовали для настройки и проверки ИИ…?"
    sc "SchHill: <Разумеется, нет, родной. Бери ширше>"
    ch "Chopin: <Ты придумал, как нам настроить виртуальную машину?>"
    sc "SchHill: <ХА! Не совсем. Но, если нам чуток повезёт, то больше думать о настройке не придётся>."
    ge "Geirby: <Это ли не то, о чём я думаю…?>"
    sc "SchHill: <АХАХАХАХА! Твоя наводка мне помогла, это правда>."
    page "Через секунду в чат был отправлен архив на 26.69 мб. Хилл тут же начал объяснять, что случилось:"
    sc "SchHill: <Если коротко, то — хвала богам! — парсинг сработал на ура.  Я нашёл несколько адресов сотрудников VMCFS и попробовал изучить их активность в интернете. Нашёл несколько серверов, к которым они постоянно обращались, начал их щупать, вдруг получится найти, так сказать, щёлочку. Ну, как минимум щёлочку найти смог. Как оказалось, они действительно обсуждали и тестировали разные коммерческие модули. Некоторые образцы получилось даже… обнаружить>"
    ki "Kira: <Это они в архиве и лежат?>"
    sc "SchHill: <Именно, родной. Я хочу, чтобы вы попробовали их запустить в своих виртуалках и рассказали, что у вас выходит. Я буду заниматься параллельно тем же. Вместе будет… веселее>."
    ch "Chopin: <Мы ищем что-то конкретное, да?>"
    sc "SchHill: <В идеале мы найдём тот самый экспериментальный модуль, который нам и нужен, да>."
    ch "Chopin: <Мы же как-то поймём, что нашли его?>"
    sc "SchHill: <Разумеется, мы как-то поймём, что нашли его. Что за вопросы?>"
    page "…Делать было нечего. В архиве лежало пять файлов формата “.vmc”. Запускали по алфавиту.{p=0.3}1. Grounded.vmc. Худший образец. При запуске у всех (кроме Киры) произошёл краш машины, причём окончательный и бесповоротный. У Кирилла он просто не запустился. Пришлось всем тратить минут 20 на переустановку. Если бы не общение в чате, то я бы сдохла от злости. Видимо, этот модуль оказался бракованным.{p=0.3}2. Mucis_Powr.vmc. Уже что-то. При запуске устанавливал аналог плеера, в который сразу же подгружается вся музыка с ПК. Причём, как проверил Шопен, подгрузка происходит моментально, в потоке, без перезапусков. Забавная фича, но не то, что нам было нужно."
    page "3. Listing.vmc. Бесполезный. При открытии в VMC включает блокнот, в котором расписывает рецепт приготовления шарлотки. Ладно бы можно было выбрать конкретное блюдо… Скорее всего, мы нашли один из черновых модулей.{p=0.3}4. Quest.vmc. Интересно. Начинает некое подобие текстовой игры с необходимостью изучать файловую систему, прогруженную модулем. Правда, файлов как таковых не завезли. Появилось лишь три архива на рабочем столе ВМ, но с такими убогими паролями, что я решила оставить их в покое где-то минут через 10. Ребят хватило ещё на меньше.{p=0.3}5. XmasGift.vmc. Скорее всего, тоже бесполезная штука. У ребят это чудо просто никак не запустилось. Даже окна с ошибкой не дождались. У меня же…"
    jump hub_bridge

# Времянка: пока ACT II Rebuild не перенесён, дальше идут архивы прототипа 2023 года.
label hub_bridge:
    glitch 0.3 0.2
    call desktop_setup
    os remove prolegomena
    viewer "old2023/images/documents/password_ACT_1.png" wait
    pause 1
    jump game

