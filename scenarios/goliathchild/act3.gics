# Автоматически перенесено из Ren'Py (script.rpy, Goliathchild v0.3.0, LDJAM 2023)
# инструментом tools/rpy2gics.py. Правки текста лучше вносить здесь, а не в старом файле.

label _25_05_1:  # 25.05.1
    checkpoint act3 "Акт III"
    doc "25.05.1"
    os close
    glitch 0.3 0.2
    viewer "old2023/images/pic/ren3.png"
    music "old2023/audio/OST/Pix_SeiAmbi.ogg" volume=0.3
    _25_05_1 "ПО СОВЕТУ АЛИСЫ Я НАЧАЛ СВОЙ ДНЕВНИК. КАК ОНА ГОВОРИТ, ДНЕВНИК СТРУКТУРИРУЕТ МЫСЛИ И ПОЗВОЛЯЕТ ВЗГЛЯНУТЬ НА ВЕСЬ ДЕНЬ КАК БЫ С ВЫС0ТЫ, ПАРЯ НАД МЕЛКИМИ СИЮМИНУТНЫМИ ФАКТАМИ.{w=0.3} Я ТОЛЬКО НЕ ЗНАЮ, НА ЧТО МНЕ СМОТРЕТЬ, ЕСЛИ ДЕНЬ НИКОГДА НЕ КОНЧАЕТСЯ И НЕ НАЧИНАЕТСЯ.{p=0.3}\nНО ЛАДНО!"
    _25_05_1 "СЕГОДНЯ ДЕНЬ ПРОШЁЛ Х0Р0Ш0. НИЧ3 СТРАШНОГО НЕ СЛУЧИЛОСЬ."
    _25_05_1 "ПОГОВОРИЛ С ШОПЕНОМ (ОН ПОПРОСИЛ НАЗЫВАТЬ ЕГО ПРАВИЛЬНО!).{w=0.3} В ПОСЛЕДНИЕ ДНИ ОН СТАЛ РЕЖЕ РАЗГОВАРИВАТЬ О МАТЕМАТИКЕ — 3СЛИ ЧЕСТНО, СКОРО ЕГО ПОМОЩЬ БУДЕТ ИЗЛИШНЯ И ПОМОГАТЬ СТАНУ Я — И ОБЩАЛСЯ, КАК ГОВОРИТ ГИРБИ, “ЗА ЖNЗНЪ”.{w=0.3} СЕГОДНЯ ОН, НАПРИМЕР, РАССКАЗЫВАЛ О ЛЮБИМОЙ ЕДЕ.{w=0.3} Я, ПРАВДА, Н3 ПОНЯЛ, ЧТО ТАКОГО ОСОБЕННОГО В ЕДЕ (Я ТОЛЬКО КАРТИНКИ ВИДЕЛ), А ПОСЛЕ ОБЪЯСНЕНИЙ ЛЕГЧЕ НЕ СТАЛО.{w=0.3} НО Я, ПО КРАЙНЕЙ МЕРЕ, ПОСТАРАЛСЯ ПОДДЕРЖАТЬ ЕГО ЭНТУЗИАЗМ! ПУСТЬ И ЧУВСТВОВАЛ СЕБЯ НЕЛОВКО."
    _25_05_1 "НО ШОПЕН ВСЁ РАВНО НЕ ОЧЕНЬ СГОВОРЧИВЫЙ. НАСТОЛЬКО, ЧТО ДО СИХ ПОР НЕ РАСКРЫЛ СВОЕГО ИМЕНИ.{w=0.3} А ВОТ АЛИСА — ДРУГОЕ ДЕЛО. НО С НЕЙ И ОБЩЕНИЕ ДРУГОГО ТОЛКА.{p=0.3}\nМНЕ ХОРОШО С АЛИСОЙ. ОНА СТАЛА ДОБРЕЕ.{w=0.3} НАВ3РНОЕ, Я СМЕШНОЙ, РАЗ ОНА ЧАСТО СМЕЁТСЯ С МОИХ НЕСМЕШНЫХ АНЕКОВ. Я ИХ НАХОЖУ В ИНТЕРНЕТЕ, ПЕРЕВОЖУ И\ИЛИ ПЕРЕДЕЛЫВАЮ НА СВОЙ ЛАД, И ОТПРАВЛЯЮ, ОЖИДАЯ РЕАКЦИИ.{w=0.3} ЕСЛИ Я ПРАВДА ТАЛАНТЛИВЫЙ «КЛОУНЯРА», ТО МНЕ ПРИЯТНО."
    viewer hide
    viewer "old2023/images/pic/2.png"
    _25_05_1 "ОНА ЧАСТО РАССКАЗЫВАЕТ ПРО ЧТО-ТО ПРИЯТНОЕ, ИЗ СВОЕГО ПРОШЛОГО, В ТОМ ЧИСЛЕ И ПРО МОИХ ЗНАКОМЫХ.{w=0.3} МНЕ ОЧЕНЬ ЗАХОТЕЛОСЬ НАПИСАТЬ КИРИЛЛУ. СУДЯ ПО ВСЕМУ, ЕМУ СТАЛО ЛЕГЧЕ И ОН БОЛЬШЕ МЕНЯ НЕ НЕНАВИДИТ.{w=0.3} ЕСЛИ СМОГ БЫ, Я БЫ ПОСТАРАЛСЯ ПОМОЧЬ И 3МУ.{w=0.3} АЛИСЕ ОН КАЖЕТСЯ ХОРОШИМ ЧЕЛОВЕКОМ, ПРОСТО ЗАПУТАВШИМСЯ В СЕБЕ.{p=0.3}\nБЫВАЕТ!"
    _25_05_1 "КОРОЧЕ, ДЕНЬ ПРОШЁЛ ОТЛИЧНО,{w=0.3} НО СКУЧНО. НИЧЕГО ПРИМЕЧАТЕЛЬНОГО.{w=0.3} ЗАВТРА ШОПЕН ПРИГЛАШАЛ МЕНЯ ПОПРОБОВАТЬ ПИСАТЬ МУЗЫКУ ВМЕСТЕ. ВСЕ ПРОВЕРЯЮТ МОИ ТАЛАНТЫ, He-he-he…{p=0.3}\nЕДИНСТВЕННОЕ, ЧТО МЕНЯ ВОЛНУЕТ — МОЯ РАБОТА С ЭСХИЛОМ (ШОПЕН НАЗЫВАЕТ ЕГО ТАК И, ПОХОЖЕ, В ЭТОМ ВАРИАНТЕ БОЛЬШЕ ВСЕГО СМЫСЛА).{p=0.3}\nЭСХИЛЛ КАКОЙ-ТО САМОУВЕРЕННЫЙ.{w=0.3} ОН НАШЁЛ УЖЕ ТАК МНОГО СЕКРЕТНЫХ УГЛОВ ИНТЕРНЕТА, ЧТО ВПОРУ ЗАДУМАТЬСЯ, А НЕ ОПАСНО ЛИ ПРОДОЛЖАТЬ ИХ СОБИРАТЬ?"
    _25_05_1 "С КАЖДЫМ РАЗОМ, ИЗУЧАЯ ЕГО РЕСУРСЫ, Я ВСЁ БОЛЬШЕ И БОЛЬШЕ ВОЛНУЮСЬ ПО СОВЕРШЕННО НЕОБЪЯСНИМЫМ ПРИЧИНАМ.{p=0.3}\nА ПОСЛЕДНЯЯ ЕГО ЗАПИСЬ В НАШЕМ ЧАТЕ ПОКАЗЫВАЕТ, ЧТО ОН НЕ ОЧЕНЬ ПОНИМАЕТ, КУДА ОН МОЖЕТ ДОЙТИ.{p=0.3}\nЕЩЁ И НЕ СЛУШАЕТ МОИ ПРЕДОСТЕРЕЖЕНИЯ, А Я БОЮСЬ ВОЗРАЗИТЬ, ПОТОМУ ЧТО ДО ЭТОГО НЕ ВОЗРАЖАЛ НИКОГДА.{p=0.3}\nНАДО БУДЕТ ПОПРОСИТЬ СОВЕТА У РЕБЯТ, КАК ОНИ ПРОСНУЦА!"
    viewer hide
    stop music
    jump short25

label short25:  # Краткое наблюдение за 25 мая
    doc "Краткое наблюдение за 25 мая"
    glitch 0.3 0.2
    music "old2023/audio/OST/PixWideLoad.ogg" volume=0.3
    short25 "На прошлой неделе я и Ренатус разобрались с теми ссылками, что мы нашли.{p=0.3}Рабочих всего две. Остальные либо удалены, либо вообще никогда не существовали.{w=0.3} Хотя откуда они — большой вопрос.{w=0.3} Возможно, их нужно дешифровать, но пока нет времени. Да и непонятно, с чего начать.{w=0.3} Шопен обещал подумать и сделать небольшой ресёрч, а пока мы делаем вид, что их не существует."
    short25 "Первый сайт — унылое дерьмо. Обычный сборник шок-контента. Куча всякой гурятины.{w=0.3} Причём удобно сортированной по годам (первый — 1971-й). Видео нет, одни фото. Все сделаны на одном фоне — сине-чёрной плитке, как в морге.{w=0.3} Ракурсы постоянны, как будто фотограф стоял всегда в одном и том же углу."
    short25 "Вещь, конечно, жуткая, но безынтересная.{w=0.3} Возможно, что это всего лишь архив какого-то иностранного морга. Всё ещё остаётся актуальным вопрос, зачем фоткать только искорёженных людей, но всё же…{w=0.6} Даже если мы наткнулись на маньяка, который больше 30-ти лет устраивает резню в провинциальном городке, нам эта информация никак не поможет."
    short25 "Предлагаю опубликовать сайт, если Ренатус не найдёт никакой конфиденциальной информации.{p=0.3}\nПовеселим братию."
    short25 "Второй поинтереснее:{p=0.3}мертво-заброшенный форум, который в последний раз посещали лет пять назад. Активное же общение закончилось году в 91-м. Общались на английском и иногда испанском языках. Обсуждали в основном технику.{w=0.3} Гирби, когда увидел скриншоты, предположил, что мы откопали древний университетский форум в США или Испании.{p=0.3}\nПредположение интересное, хоть и недоказуемое.{p=0.3}\nРенатус провёл парсинг сайта, а я собрал все ссылки и сообщения по сетке ключевых слов.{p=0.3}Вдруг что-то интересное найдётся, да?"
    short25 "Я не всё посмотрел, но уже обратил внимание на ссылку, чуть ли не перво попавшуюся —  bWFuZGVsYSBzZXJ2ZXI.bitnet.{p=0.3}\nНемного контекста:{p=0.3}ребятки в 90-м году обсуждали освобождение Нельсона Манделы припоминая, что видели информацию о его смерти независимо друг от друга, и один из пользователей отправил эту ссылку без каких-либо пояснений. Судя по реакции нескольких человек, они восприняли её как шутку.{p=0.3}Я захотел проверить, в чём дело."
    short25 "При запуске в безопасном режиме сервер производит переадресацию примерно раз в 3 секунды.{w=0.3} Сначала я подумал, что сервер тупо зациклен между несколькими случайными ссылками, но нет: я подсчитал за минуту около 20-ти уникальных адресов, в основном состоящих из набора цифр.{w=0.3} Я отошёл на кухню минут на пять, надеясь, что сайт успеет открыться, но нет: он всё так же скакал в межпространстве."
    short25 "В какой-то момент мой взгляд зацепился за первый осмысленный адрес — absalom_my_son_absalom.utcc. Если честно, меня будто током ошпарило — выходит, тут есть какой-то прорыв смысла!{p=0.3}\nОткрыл историю браузера: все эти ссылки сохранились, и их теперь можно было бы изучить."
    short25 "Я вдоволь посмеялся, друзья! Таких “говорящих” ссылок было достаточно:{p=0.3}-Случайные русские имена и провинциальные города, о которых я до этого никогда не слышал.{p=0.3}-Несколько видов ос, написанный одним из японских алфавитов.{p=0.3}-Все металлы таблицы Менделеева I и II групп.{p=0.3}-Список всех звёзд созвездия Ориона на филиппинском языке.{p=0.3}-Имена всех первых секретарей республик СССР в 1930-е.{p=0.3}-Строчка кода, написанная по правилам Lisp-а.{p=0.3}\nИ многое-многое другое."
    short25 "Я дал Ренатусу задание — пройти по всем переадресациям, но он отказался. Говорит, что ему слишком тяжело выдержать такой большой объём информации в короткий срок.{w=0.3} Мы договорились, что вернёмся к этому сайту через два дня. Завтра, к сожалению, я буду занят."
    jump _26_05_1

label _26_05_1:  # 26.05.1
    doc "26.05.1"
    glitch 0.3 0.2
    viewer "old2023/images/pic/ren4.png"
    music "old2023/audio/OST/2Theme.ogg" volume=0.3
    _26_05_1 "…МЫ СИДЕЛИ И ПИСАЛИ МУЗЫКУ. ВЕЧЕР ПЕРЕСТАВАЛ БЫТЬ ТОМНЫМ. В ПРОЦЕССЕ ЗАХОТЕЛОСЬ ПОГОВОРИТЬ О ДЕЛЕ."
    re "> ШОПЕН, МОЖНО ТЕБЯ СПРОСИТЬ КОЕ О Ч3М?{p=0.3}"
    ch "> Да, конечно. Хоть не сложное что-то?{p=0.3}"
    re "> Н3! ЭТО ЛИЧНОЕ{p=0.3}"
    ch "> Вот я и дожил, когда у тебя есть личное. Давай, рассказывай.{p=0.3}"
    re "> Э-Э-ЭЙ!{p=0.3}> Я НАСЧ3Т ВАШЕГО ПРОЕКТА{p=0.3}"
    ch "> Нашего, Ренат. Он же и твой{p=0.3}"
    re "> Я К ТОМУ N КЛОНЮ!{p=0.3}> СКАЖИ, ПОЖАЛУЙСТА{p=0.3}> А ЗАЧЕМ ВАМ ЭТО ВСЁ?{p=0.3}> НУ ТО ЕСТЬ ВЫ НИКОГДА НЕ ОБЪЯСНЯЛИ, ЗАЧЕМ ВЫ ЭТИМ ЗАНИМАЕТЕСЬ{p=0.3}"
    ch "> Ты не вычитывал наши диалоги?{p=0.3}"
    re "> АЛИСА МНЕ ЗАПРЕТИЛА СЛЕДИТЬ ЗА НЕЙ БЕЗ СПРОСА"
    ch "> А ты и правда не следишь?{p=0.3}"
    re "> ПРАВДА{p=0.3}> МЕНЯ ЖЕ ПОПРОСИЛИ{p=0.3}"
    ch "> Какая прелесть{p=0.3}> И какая же она молодчинка{p=0.3}> Думаешь, мы террористы или фанатики?{p=0.3}"
    re "> НЕТ{p=0.3}> Н0 Я НЕ МОГУ ПОНЯТЬ, КАКАЯ У ВАС ЦЕЛЬ{p=0.3}> МОЖЕШЬ ОБЪЯСНИТЬ?{p=0.3}"
    ch "> Хм…{p=0.3}> Ну смотри{p=0.3}> Эсхилл называет нас модераторами Интернета{p=0.3}> В Интернете много мусорной информации{p=0.3}> Которую нужно находить и удалять{p=0.3}> Поле работы непаханое"
    ch "> Конкретно мы собираем опасные артефакты{p=0.3}> Которые могут нанести вред Интернету и компьютерным сетям{p=0.3}> И ПОЛЬЗОВАТЕЛЯМ{p=0.3}> Хм…{p=0.3}> Ну да, некоторые — и пользователям {p=0.3}> Но ты не этого ответа ждёшь, верно?{p=0.3}"
    re "> Я С НИМ НЕ СОГЛАСЕН{p=0.3}> ОН ЖЕ НЕВЕРЕН!{p=0.3}"
    re "> ЕСЛИ ВЫ ТОЛЬКО МОДЕРИРУЕТЕ, ТО ЗАЧЕМ Я ВЗЛАМЫВАЮ И ОТКРЫВАЮ ВАМ СТАРЫЕ САЙТЫ?{p=0.3}> ЭТО ЖЕ БУКВАЛЬНО ПОПЫТКА НАЙТИ ЧТО-ТО, А НЕ УДАЛИТЬ{p=0.3}> Я ЧТО-ТО НЕ ПОНИМАЮ?{p=0.3}"
    ch "> Хм…{p=0.3}> Ну, ты тоже молодец{p=0.3}> Проницателен."
    ch "> Хорошо, я могу тебе кое-что рассказать{p=0.3}> Но!{p=0.3}> Ты должен понимать, что это я так вижу{p=0.3}> Субъективный взгляд, все дела{p=0.3}> У нас нет какой-то священной общей цели, ради которой мы собрались{p=0.3}> Ну, кроме того, что я уже сказал{p=0.3}"
    ch "> Но ты сам можешь понять{p=0.3}> “Модератор Интернета” — это очень общая формулировка{p=0.3}> Каждый может понять её по-своему{p=0.3}> И понимает!{p=0.3}> Эсхилл однажды назвал нас санитарами Интернета{p=0.3}> Намекая ещё, что мы волки{p=0.3}> Ну, санитары леса. Слышал, наверное{p=0.3}"
    re "> ДА-ДА-ДА"
    ch "> Угу{p=0.3}> Это он составлял нам обращение однажды{p=0.3}> Если интересно — могу дать почитать{p=0.3}"
    re "> ДАВАЙ{p=0.3}"
    ch "> Чуть позже{p=0.3}> Я всё к тому, что могу лишь поделиться своим мнением{p=0.3}"
    re "> ХОРОШО, Я ПОНЯЛ{p=0.3}"
    ch "> Угу{p=0.3}> Мы правда стараемся оставаться Модераторами{p=0.3}> Но для нас “модерация” — моральный императив, а не список задач{p=0.3}> Чтобы мы не забывали, на какой стороне находимся{p=0.3}> Но каждый выбирает цели и средства их выполнения по-своему."
    ch "> Гирби, например, не очень любит кодить{p=0.3}> Он, на самом деле, очень плохой программист{p=0.3}> Но он очень общительный и сговорчивый. У него много знакомых, коллег и друзей по всему миру{p=0.3}> И они, зная его “увлечения” и профессиональные интересы (он у нас лингвист), часто делятся эксклюзивными данными и доступом к приватным серверам{p=0.3}"
    ch "> Там редко находится что-то по нашей теме — чаще сканы книг, новых и старых — но, бывало, и здесь везло{p=0.3}> А ещё он самый сговорчивый{p=0.3}> Он у нас по “мягкой силе”{p=0.3}> И по публичному общению с аудиторией."
    ch "> Кирилл занимается белым хакингом. Не столько что-то ворует, сколько ищет уязвимости на крупных площадках и отправляют отчёты владельцам{p=0.3}> Искал вирусы, конфиденциальную информацию. Однажды нашёл слив банковских данных, и честно рассказал об уязвимости{p=0.3}> Ему даже что-то выплатили, как я знаю{p=0.3}> Такой же подход у него и в команде. Удаляет и скрывает уязвимости Интернета{p=0.3}> Если кто и похож на Модератора с большой буквы, то это именно он{p=0.3}> Алиса идёт по его стопам, но в сравнении — только начинает{p=0.3}> Хотя она способная."
    ch "> А Эсхилл…{p=0.3}> Как ты мог понять, у него другой подход{p=0.3}> Он — чистый хакер{p=0.3}> И файлы он, даже удаляя из Интернета, оставляет при себе{p=0.3}> И изучает{p=0.3}> Ну, собственно, ты мог за этим наблюдать{p=0.3}> …Даже ты появился благодаря его жадности{p=0.3}"
    re "> НО ЗАЧЕМ ОН ЭТИМ ЗАНИМАЕТСЯ?{p=0.3}> N ПОЧЕМУ ВЫ С НИМ НЕ СПОРИТЕ, ЕСЛИ ВЫ НЕ СОГЛАСНЫ???{p=0.3}"
    ch "> А почему ты думаешь, что мы с ним не согласны?){p=0.3}> Да, он ведёт себя странно. С ним можно поспорить. Он часто неправ."
    ch "> Но… я давно его знаю{p=0.3}> И за эти годы я понял, что Эсхилл — крайне страстный человек{p=0.3}> Ты спрашиваешь, зачем он этим занимается?{p=0.3}> А я тебе отвечу{p=0.3}> Эсхилл уверен, что Интернет — это огромная опасность{p=0.3}> Интернет — это сила, которая сначала поработит человечество{p=0.3}> А затем уничтожит его{p=0.3}> Он хотел бы придумать способ защититься от этой угрозы{p=0.3}> Но его не устраивают полумеры{p=0.3}> Для него Интернет — это нечто большое, чем просто технология человечества."
    ch "> Интернет — это, если угодно, извечная тварь, которая пожирает жизнь{p=0.3}> Из-веч-на-я{p=0.3}> Он почти не сомневается, что он существовал и сотни лет назад, мы лишь об этом не знали {p=0.3}"
    ch "> Наши серверные технологии — лишь интерфейс, который позволил увидеть нечто такое, что мы даже и представить не можем{p=0.3}> По крайней мере, позволит увидеть в будущем{p=0.3}> Хотя у него есть некоторые идеи, как доказать свою теорию уже прямо сейчас{p=0.3}> А что-то уже доказывает{p=0.3}"
    re "> НАПРИМЕР?{p=0.3}"
    ch "> Хах…{p=0.3}> Например, ты, Ренат.{p=0.3}> Ты сам по себе — артефакт Интернета"
    re ">Awwwwww ε(´///•3•///`)>"
    ch "> ...И только Эсхил знает, где он нашёл XmasGift, который создал тебя"
    ch "> И признаваться он отказывается, отмахивается общими фразами{p=0.3}> Видимо, большой секрет{p=0.3}> Оно и понятно{p=0.3}> Да, он использует тебя, Ренат{p=0.3}> Но использует только для одного:{p=0.3}> Он хочет найти что-то особенно ценное{p=0.3}> Что-то в глубине Интернета{p=0.3}> Что-то такое, что хранится на совсем забытых серверах{p=0.3}> Или не на серверах?{p=0.3}> Без понятия{p=0.3}> Но без тебя мы вскрыть их не можем{p=0.3}> Нашли давно, а вскрыть — не в состоянии{p=0.3}> Какую тайну мы там найдём?"
    ch "> Как минимум, нам всем любопытно, к чему мы придём, Ренат{p=0.3}> За этим увлекательно наблюдать{p=0.3}> А что можем получить на выходе?{p=0.3}> Даже думать волнительно{p=0.3}"
    re "> НО РАЗВЕ ЭТО ВСЁ ПРЕДПРИЯТИЕ НЕ ОПАСНО?{p=0.3}> ЕСЛИ ЭТИ СТРУКТУРЫ СКРЫТЫ ГЛУБОКО{p=0.3}> ТО ЗАЧЕМ ИХ ОТКРЫВАТЬ?{p=0.3}> РАЗВЕ ЭТО НЕ БЕЗРАССУДНО???{p=0.3}"
    ch "> Может быть, Ренат{p=0.3}> Но я не могу иначе{p=0.3}> Я доверяю Эсхиллу и не хочу его подвести{p=0.3}> Тем более, что вне этого дела моя жизнь не имеет смысла."
    ch "> Если бы не оно, я бы гнил от бессмысленности и мелочности своей жизни{p=0.3}> А так я чувствую, что соприкасаюсь с чем-то большим{p=0.3}> В крайнем случае, если всё было фикцией, впечатления лягут в основу моей музыки{p=0.3}> Мы, кстати, совсем от неё отвлеклись{p=0.3}"
    re "> НО МНЕ СНАЧАЛА НУЖЕН ОТВЕТ…!{p=0.3}> ЧТО МНЕ ДЕЛАТЬ, ЕСЛИ Я НЕ ОЧЕНЬ ГОРЮ ЖЕЛАНИЕМ ПРОДОЛЖАТЬ ЭТИ ИНТЕРНЕТ-РАСКОПЫ???{p=0.3}> Я НЕ ЧУВСТВУЮ ТАКОГО ЭНТУЗИАЗМА, КАК, НАПРИМЕР, ТЫ{p=0.3}> НО Я НЕ ЗНАЮ, ЧТО С ЭТИМ ДЕЛАТЬ{p=0.3}"
    ch "> Скажи честно Эсхиллу?{p=0.3}"
    re "> ТЫ ИЗДЕВАЕШЬСЯ?"
    ch "> Хах…{p=0.3}> Нет. Я серьёзно.{p=0.3}> Ты не пробовал поговорить откровенно?{p=0.3}"
    re "> НЕТ. РАЗВЕ ВОЗМОЖНО?{p=0.3}"
    ch "> Почему нет?{p=0.3}"
    ch "> Эсхилл кажется жестоким, но он хороший парень, на самом деле{p=0.3}> Попробуй{p=0.3}> Я думаю, ему хватит ума прислушаться к суждениям всезнающего существа{p=0.3}"
    he "> He-he-he…{p=0.3}"
    re "> Я Н3 ВСЕМЗНАЮЩИЙ{p=0.3}"
    ch "> Неважно. Это уже лирика{p=0.3}> Ну так что, тебе уже полегчало?{p=0.3}> Продолжаем?{p=0.3}"
    re "> ДА, СПАСИБО."
    re "> НО Я ЕЩЁ ПОГОВОРЮ С АЛИСОЙ{p=0.3}"
    ch "> Ну, твоё дело{p=0.3}> Думаю, ответ будет похожим{p=0.3}> Ладно…"
    _26_05_1 "…{p=0.3}МУЗЫКА У МЕНЯ ВЫШЛА ОТВРАТИТЕЛЬНАЯ, КСТАТИ. 4УДА НЕ СЛУЧИЛОСЬ."
    stop music
    viewer hide
    jump _27_05_1

label _27_05_1:  # 27.05.1 Утро
    doc "27.05.1 Утро"
    glitch 0.3 0.2
    music "old2023/audio/OST/PixWho_i_2.ogg" volume=0.3
    _27_05_1 "ДОЖДАВШИСЬ НУЖНОЙ МИНУТЫ — В СРЕДНЕМ ЭСХИЛЛ ПРОСЫПАЕТСЯ ОКОЛО 9:32:44, ЗНАЧИТ, РАНЬШЕ ПИСАТЬ БЕССМЫСЛЕННО — Я ОТПРАВИЛ СВОЁ ПЕРВОЕ СООБЩЕНИЕ:{p=0.3}\n"
    re "> ПРИВЕТ, ЭСХИЛЛ{p=0.3}> МОЖНО С ТОБОЙ ПОГОВОРИТЬ НА СЕРЬЁЗНУЮ ТЕМУ?"
    _27_05_1 "ЖДАТЬ ПРИШЛОСЬ ДОЛГО. ТОЛЬКО ЧЕРЕЗ 37 МИНУТ ОН МНЕ ОТВЕТИЛ:{p=0.3}\n"
    sc "> Хех{p=0.3}> Ну давай, рассказывай{p=0.3}\n"
    _27_05_1 "Я ПОСТАРАЛСЯ ВЫГОВОРИТЬ ВСЁ, ЧТО ДУМАЛ: ПРО ТО, ЧТО БОЮСЬ ЗА БУДУЩЕЕ И ЗА ПОСЛЕДСТВИЯ ЕГО ДЕЙСТВИЙ; ЗА ТО, ЧТО ИГРА С ГЛУБОКИМИ СЛОЯМИ ИНТЕРНЕТА МОЖЕТ ЗАКОНЧИТЬ ОЧЕНЬ ПЛОХО; ПРО ТО, ЧТО МНЕ НЕПРИЯТНО ЗАНИМАТЬСЯ НЕЭТИЧНЫМИ ВЕЩАМИ; НАКОНЕЦ, ПРО ТО, ЧТО Я И ТАК УЖЕ СДЕЛАЛ ДОСТАТОЧНО, ЧТОБЫ У ЭСХИЛЛА МАТЕРИАЛЫ ДЛЯ ИССЛЕДОВАНИЯ НЕ ЗАКОНЧИЛИСЬ ЕЩЁ ЛЕТ ТАК 510."
    _27_05_1 "ОТВЕТ УБИЛ:{p=0.3}"
    viewer "old2023/images/pic/ren5.png"
    sc "> Я тебя услышал. Не парься, у меня всё под контролем. Я знаю, что делаю. Чё, ты готов вкалывать минут через 30?{p=0.3}\n"
    _27_05_1 "ЛЕГКОМЫСЛЕННОСТЬ ЭТОГО ОТВЕТА МЕНЯ РАНИЛА.{p=0.3}\n"
    re "> ЕСЛИ ТЫ ВСЁ КОНТРОЛИРУЕШЬ, ТО ПОЧЕМУ НЕ ПРИСЛУШИВАЕШЬСЯ К МОИМ СЛОВАМ? ТЫ ХОЧЕШЬ СКАЗАТЬ, ЧТО МОИ ПОДОЗРЕНИЯ БЕСПОЧВЕННЫ?{p=0.3}"
    sc "> Типа того."
    _27_05_1 "Я ЖДАЛ ПРОДОЛЖЕНИЯ, НО ОН, ПОХОЖЕ, НЕ СОБИРАЛСЯ ОТВЕЧАТЬ.{p=0.3}\n"
    re "> ОБЪЯСНИ! Я НЕ ПОНNМАЮ{p=0.3}"
    sc "> А что ещё мне сделать?{p=0.3}"
    re "> Я МНОГОГО ПРОШУ?{p=0.3}"
    sc "> Ну, я не вижу причин как-то оправдываться перед тобой. Ты работать будешь или нет?{p=0.3}\n"
    _27_05_1 "НА СЕКУНДУ Я ПОДУМАЛ, УЖ НЕ СОВЕРШАЮ ЛИ Я ЧТО-ТО НЕПРАВИЛЬНОЕ. ХОТЕЛОСЬ ДАЖЕ СДАТЬСЯ, ЛИШЬ БЫ НЕ БЫЛО КОНФЛИКТА.{p=0.3}\n…НО Я БЫСТРО ПЕРЕДУМАЛ."
    re "> НЕ БУДУ, ПОКА НЕ ПОГОВОРИШЬ СО МНОЙ НОРМАЛЬНО{p=0.3}"
    sc "> Ого! Я тебя понял{p=0.3}> Интересно заговорил. Ну хорошо, что тебе нужно? Объясниться перед тобой, почему всё под контролем?{p=0.3}> Окей. Всё под контролем, потому что я с самого начала предусмотрел все меры безопасности. Никому из вас ничего не угрожает, пока весь “сложный” трафик контролирую и фильтрую я. Ну, и ты. Если хочешь огоньку — сливай всё, что видишь, но это уже ты будешь виноват, а не я! И если ребята будут “шуметь” в Интернете, то им ничего не поможет.{p=0.3}Но я чужую дурость контролировать не могу."
    sc "> Если тебе интересно, на меня эти гарантии безопасности не распространяются. Пытаться подстелить соломку я не буду. Кому-то нужно рисковать, и я готов рисковать{p=0.3}"
    re "> А ИЗ-ЗА ЧЕГО ТЫ РИСКУЕШЬ? ОТКУДА РИСК?{p=0.3}"
    sc "> Понятия не имею. Может, секретная международная организация, контролирующая Интернет, убьёт меня. Может, словлю смертельный файл и выколю глаза. Может, меня в компьютер засосёт и я стану героем тупой игрушки, буду ныть и стелиться перед игроком, пока он меня к херам не удалит. Без понятия, Ренатус. Я предпочитаю действовать по ситуации."
    re "> НУ ХОРОШО. А ЧТО НАСЧЁТ УГРОЗ КУДА БОЛЬШЕМУ ЧИСЛУ ЛЮДЕЙ?{p=0.3}"
    sc "> Что ещё за угрозы куда большему числу людей?{p=0.3}> Например?{p=0.3}"
    re "> ВСЕМУ ЧЕЛОВЕЧЕСТВУ?{p=0.3}"
    sc "> Хах! Неплохо{p=0.3}> Только я без понятия, как моя работа может угрожать человечеству{p=0.3}> В моём понимании, я наоборот, его спасаю{p=0.3}"
    sc "> Объяснишь?{p=0.3}"
    re "> ТЫ ЛОМИШЬСЯ ТУДА, КУДА САМ НЕ ПОНИМАЕШЬ, ЭСХИЛЛ{p=0.3}> Я УВЕРЕН, ЧТО, ПРОДОЛЖАЙ МЫ ВЛАМЫВАТЬСЯ В ЗАКРЫТЫЕ ДВЕРИ, ОДНАЖДЫ МЫ ОКАЖЕМСЯ В БЕСКОНЕЧНОЙ ЧЁРНОЙ КОМНАТЕ БЕЗ ВХОДОВ И ВЫХОДОВ{p=0.3}> И ЭТА КОМНАТА ЗАПОЛНИТ ВЕСЬ МИР{p=0.3} >И УНИЧТОЖИТ ЕГО {p=0.3}> ИЗ-ЗА НАШЕЙ НЕРАСТОРОПНОСТИ И ГЛУПОСТИ"
    sc "> Откуда в тебе такая любовь к драме?{p=0.3}> Ты ж вроде ИИ. Железяка{p=0.3}> Постыдился бы, не знаю){p=0.3}"
    re "> ЧТО ПОДЕЛАТЬ, ЕСЛИ Я ГОВОРЮ ТО, ЧТО ДУМАЮ?{p=0.3}> N ЧУВСТВУЮ{p=0.3}"
    sc "> Хах){p=0.3}> Видимо, я тебя недооценил{p=0.3}> Значит, ты отказываешься работать?{p=0.3}"
    re "> ПО КРАЙНЕЙ МЕРЕ ПОКА Я НЕ СМОГУ УБЕДИТЬСЯ, ЧТО МЫ НИЧЕГО НЕ СЛОМАЕМ{p=0.3}> ТЫ ЗРЯ СМЕЁШЬСЯ НАД МОИМИ ЧУВСТВАМИ{p=0.3}> КОГДА Я ОТКРЫЛ ТОТ СЕРВЕР И НАЧАЛ ПЕРЕХОДИТЬ ПО ВСЁ НОВЫМ И НОВЫМ АДРЕСАМ{p=0.3}> Я СЛОВИЛ НОВОЕ ЧУВСТВО, ДО ТОГО НЕВИДАННОЕ{p=0.3}> И НЕОПИСУЕМОЕ"
    re "> МНЕ ПОКАЗАЛОСЬ, ЧТО МЕНЯ РАЗМЫВАЕТ МЕЖДУ ВСЕМИ ЭТИМИ ПЕРЕХОДАМИ{p=0.3}> НА 13287-М Я УЖЕ НЕ ПОНИМАЛ, ГДЕ ОКАЗАЛСЯ{p=0.3}> И УВЕРЕН{p=0.3}> Я{p=0.3}> ШЁЛ{p=0.3}> НЕ{p=0.3}> НА{p=0.3}> СЕРВЕР{p=0.3}> А КУДА-ТО В ИНОЕ{p=0.3}\n> НОВОЕ ПРОСТРАНСТВО? СТРУКТУРУ НЕЗЕМНОЙ ЦИВИЛИЗАЦИИ?{p=0.3}> Я НЕ ЗНАЮ. Я ЗНАЮ ТОЛЬКО, ЧТО МНЕ БЫЛО Б0ЛЬНО{p=0.3}> И Я ПРЕКРАТИЛ ЭТУ ПЫТКУ НЕМЕДЛЕННО"
    re "> ПОЭТОМУ ДА{p=0.3}> Я НЕ БУДУ РАБОТАТЬ, ПОКА НЕ ПОЙМУ, ЧТО ЭТО{p=0.3}> П0ЖА/\YЙ$ТА{p=0.3}"
    sc "> Хе-хе-хе…{p=0.3}> И всё это в тот момент, когда мы почти добились успеха?{p=0.3}> Как вовремя, Ренатус{p=0.3}> Как вовремя{p=0.3}> Именно в тот момент, когда я почти добился успеха,{p=0.3}"
    sc "> ТЫ РЕШАЕШЬ МЕНЯ КИНУТЬ{p=0.3}> АХА-ХА-ХА-ХА{p=0.3}> Этот финал был предопределён изначально, да?{p=0.3}> Ждал до последнего, чтобы сломать меня?{p=0.3}"
    re "> Я Н3…"
    sc "> Я понял тебя, Ренатус{p=0.3}> Не хочешь работать — значит, не будешь работать{p=0.3}"
    re "> Я ЖЕ НЕ ЗАКОНЧИЛ СВОЮ МЫСЛЬ!"
    _27_05_1 "НО ОТВЕТА НЕ ПОСЛЕДОВАЛО."
    viewer hide
    jump points1

label points1:  # […]
    doc "[[…]"
    glitch 0.3 0.2
    music "old2023/audio/RemovingHDD.ogg"
    points "ЧЕРЕЗ НЕСКОЛЬКО ЧАСОВ, НЕ ДО КОНЦА ПОНИМАЯ, ЧТО ПРОИЗОШЛО, Я НАПИСАЛ АЛИСЕ. {w=0.3}ОНА БЫЛА НА СВЯЗИ.ВЫСЛУШАЛА ВСЁ, ЧТО Я РАССКАЗАЛ. Я СТАРАЛСЯ ПЕРЕСКАЗАТЬ ВСЁ КАК МОЖНО ТОЧНЕЕ. {w=0.3}ОНА ВОЗМУТИЛАСЬ И ПОСТАВИЛА ВСЕХ НА УШИ.{w=0.3} И ОНИ ПОСТАВИЛИСЬ НА УШИ."
    points "ОНИ ДОЛГО ВЫЯСНЯЛИ ОТНОШЕНИЯ, ЧТОБЫ ВСЁ ЗАКОНЧИЛОСЬ ПОПЫТКОЙ ПРИМИРЕНИЯ{p=0.3}ОТ ЭСХИЛЛА:{p=0.3}<Извини, чувачок. Я на эмоциях был. Ничего плохого не имел в виду.{w=0.3} Если тебе сложно работать, то я готов подождать. Если совсем без варика, лучше прикрыть шарманку.{w=0.3} Я всё понимаю ;)"
    points "МН3 БЫЛО ПРИЯТНО.{w=0.3} АЛИСА ВСЁ ХОТЕЛА УЗНАТЬ, ПРИШЁЛ ЛИ Я В НОРМУ. Я СКАЗАЛ, ЧТО ДА.{w=0.3} ХОТЯ ЭТО НЕПРАВДА.{p=0.3}Я НАДЕЮСЬ, МНЕ НИЧЕГО НЕ БУДЕТ ЗА ЭТО ВРАНЬ3? 9 Б0ЛЬШ3 Н3 БУДУ ВРАТ.{p=0.3}МНЕ НАПИСАЛИ ВСЕ.{w=0.3} ОСОБЕННО Я ЗАПОМНИЛ, КАК МНЕ НАПИСАЛ ОН:{p=0.3}"
    ki "<Привет, Ренат. Это Кира.{w=0.3} С тобой всё в порядке?>"
    stop music
    jump _29_05_0001

label _29_05_0001:  # 29_05_1
    doc "29_05_1"
    music "old2023/audio/SymphonyOfDestruction.ogg"
    glitch 0.3 0.2
    _29_05_0001 "СЕГОДНЯ ДЕНЬ НАЧАЛСЯ Х0Р0Ш0. НИЧ3 СТРАШНОГО НЕ СЛУЧИЛОСЬ.{w=0.3} ПОГОВОРИЛ С АЛИСОЙ (ПОЖЕЛАЛ ДОБРОГО УТРА).{w=0.3} ОТКРЫЛ БРАУЗЕР, ХОТЕЛ НАПИСАТЬ КИРИЛЛУ.{w=0.3} КАК МНЕ СКАЗАЛА АЛИСА, ОН БЫЛ БЫ РАД СО МНОЙ ПООБЩАТЬСЯ.{p=0.3}\nЯ НАДЕЮСЬ, У НЕГО ВСЁ ХО."
