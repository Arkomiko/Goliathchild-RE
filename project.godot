; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GoliathChild:RE"
config/description="Ремейк визуальной новеллы Goliathchild (LDJAM 2023) со встроенным редактором историй GiC_OS."
config/version="0.1.2.1102a"
run/main_scene="res://game/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GoliathChildRE"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GicLocalization="*res://addons/gic_engine/Core/Localization/GicLocalization.cs"
Settings="*res://game/Autoload/SettingsManager.cs"
InputDevices="*res://game/Autoload/InputDeviceManager.cs"
Saves="*res://game/Autoload/SaveManager.cs"
Game="*res://game/Autoload/GameManager.cs"
DevAutomation="*res://game/Autoload/DevAutomation.cs"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1600
window/size/window_height_override=900
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="GoliathChildRE"

[editor_plugins]

enabled=PackedStringArray("res://addons/gic_engine/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[internationalization]

locale/fallback="ru"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
